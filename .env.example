# ── The server ────────────────────────────────────────────────────────────────

# Required: the address it listens on, with the host written out — this machine's tailscale
# address (tailscale ip -4), or 127.0.0.1 behind tailscale serve. A bare :3000 is every interface.
HOMELAB_MCP_HTTP_ADDR=
# Required: the token every client sends as Authorization: Bearer. openssl rand -hex 32
HOMELAB_MCP_HTTP_TOKEN=

# Docker only: the id of the host's docker group, which the container joins to reach the socket.
# getent group docker | cut -d: -f3
DOCKER_GID=

# One bare host for every service: each fills in its own port. A family whose key is missing
# is not registered at all.
SERVER_URL=http://localhost
# RADARR_API_KEY=
# SONARR_API_KEY=
# PROWLARR_API_KEY=
# JELLYFIN_API_KEY=
# BAZARR_API_KEY=

# Optional: monitoring without that family's writes.
# HOMELAB_MCP_RADARR_READONLY=1
# HOMELAB_MCP_SONARR_READONLY=1
# HOMELAB_MCP_PROWLARR_READONLY=1
# HOMELAB_MCP_JELLYFIN_READONLY=1
# HOMELAB_MCP_BAZARR_READONLY=1

# Optional: the containers exec and restart may name. Unset, neither tool exists.
# HOMELAB_MCP_ALLOW_CONTAINER_NAMES=jellyfin,sonarr,radarr

# ── The Telegram bot ──────────────────────────────────────────────────────────

# A bot of its own from @BotFather: two processes long-polling one token fail with 409 Conflict.
TELEGRAM_BOT_TOKEN=
# Numeric ids, comma-separated — @userinfobot tells you yours.
TELEGRAM_ALLOWED_USER_IDS=
# Those of them who may also remove, stop, restart and reconfigure.
# TELEGRAM_ADMIN_USER_IDS=

# Optional: plain words, through Claude. Without it, commands only.
# ANTHROPIC_API_KEY=
# TELEGRAM_MODEL=claude-sonnet-5-5
# TELEGRAM_EFFORT=medium
# The most a day of plain words may cost, in dollars; they pause until midnight past it.
# TELEGRAM_DAILY_BUDGET_USD=1.00

# When the admins get the daily digest, local time; off for never.
# TELEGRAM_DIGEST_AT=17:00

# The image sets TZ=America/Sao_Paulo; this replaces it.
# TZ=America/Sao_Paulo
